# ===== NutriMama AI - Environment Configuration =====
# Copy this file to .env and fill in real values. NEVER commit .env to version control.

# --- App ---
APP_NAME=NutriMama AI
APP_ENV=development
DEBUG=true

# --- Security / JWT ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
DATABASE_URL=sqlite:///./nutrimama.db

# --- Generative AI Provider ---
# Choose "gemini" or "openai"
AI_PROVIDER=gemini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro

OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# --- RAG / ChromaDB ---
CHROMA_PERSIST_DIR=./rag/chroma_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# --- File Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Frontend (served by FastAPI static files in this stack) ---
FRONTEND_DIR=../frontend
